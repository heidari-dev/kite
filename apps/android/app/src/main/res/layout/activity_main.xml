<?xml version="1.0" encoding="utf-8"?>
<!--
    One column, centred: the kite, what it is doing, one primary button. The column is capped at
    480dp and the whole thing scrolls, so large text, landscape and small phones never clip.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingEnd="24dp"
        android:paddingStart="24dp"
        android:paddingTop="16dp">

        <io.github.heidaridev.kite.KiteView
            android:id="@+id/kite"
            android:layout_width="240dp"
            android:layout_height="240dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:textColor="@color/kite_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:textColor="@color/kite_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center_horizontal"
            android:textColor="@color/kite_text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_primary"
            android:minHeight="56dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/kite_on_button"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:minHeight="56dp"
            android:stateListAnimator="@null"
            android:text="@string/pair"
            android:textAllCaps="false"
            android:textColor="@color/kite_button"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:textColor="@color/kite_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="monospace"
            android:gravity="center_horizontal"
            android:textColor="@color/kite_text"
            android:textSize="36sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/computers_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/computers"
            android:textColor="@color/kite_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/computers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
