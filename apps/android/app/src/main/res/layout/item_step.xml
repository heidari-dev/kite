<?xml version="1.0" encoding="utf-8"?>
<!-- One step of the first-run card. The row is one stop for a screen reader; its description is set
     in code, so the children stay out of the way. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_step"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/marker"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_marker"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/kite_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/kite_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:textColor="@color/kite_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/step_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:textColor="@color/kite_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
