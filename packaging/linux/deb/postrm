#!/bin/sh
# Kite keeps nothing after it is removed: the key and paired phones in /var/lib/kite go with the
# user and group. Phones are paired again after a reinstall.
set -e

case "$1" in
remove | purge)
  # Only what the package made: a person's own account called kite is left alone.
  home=$(getent passwd kite | cut -d: -f6)
  if [ -z "$home" ] || [ "$home" = /var/lib/kite ]; then
    rm -rf /var/lib/kite
    if [ -n "$home" ]; then userdel kite || echo "kite: could not delete the kite user" >&2; fi
    if getent group kite >/dev/null; then groupdel kite || true; fi
  fi
  if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
  ;;
esac
