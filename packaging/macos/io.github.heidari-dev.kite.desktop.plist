<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Starts the tray icon of the desktop app when a user logs in. -->
  <key>Label</key>
  <string>io.github.heidari-dev.kite.desktop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Kite.app/Contents/MacOS/kite-desktop</string>
    <string>--hidden</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
