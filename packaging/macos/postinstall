#!/bin/sh
# Starts the daemon, and the tray icon for the user who is signed in.
set -u
[ "${3:-/}" = / ] || exit 0
/bin/launchctl bootstrap system /Library/LaunchDaemons/io.github.heidari-dev.kite.plist || exit 1
uid=$(/usr/bin/stat -f %u /dev/console 2>/dev/null)
if [ -n "$uid" ] && [ "$uid" != 0 ]; then
  /bin/launchctl bootstrap "gui/$uid" /Library/LaunchAgents/io.github.heidari-dev.kite.desktop.plist 2>/dev/null
fi
exit 0
